// Turns the static site into a Worker that also answers /api/* (theories, feedback, push) and runs two crons.
{
  "name": "brocettes",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Every 30 minutes: look for new session notes. Tuesdays 21:00 UTC: game-night reminder (REMINDER_CRON in worker/index.js).
  "triggers": { "crons": ["*/30 * * * *", "0 21 * * 2"] },
  "kv_namespaces": [
    { "binding": "THEORIES", "id": "5db480ba370a4b3abd4fcca062964eb2" }
  ]
}
