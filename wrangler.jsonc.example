// Rename to wrangler.jsonc once the KV namespace exists (see docs/theory-board.md).
// It turns the static site into a Worker that also answers /api/theories.
{
  "name": "brocettes",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "THEORIES", "id": "PASTE_THE_KV_NAMESPACE_ID_HERE" }
  ]
}
